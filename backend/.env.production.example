# Copy to backend/.env.production on the VM and fill in real values.
# Never commit this file with real secrets.

# --- Django ---
SECRET_KEY=GENERATE-A-LONG-RANDOM-STRING-HERE
DEBUG=False
ALLOWED_HOSTS=api.urbanattic.francocazal.com
DJANGO_SETTINGS_MODULE=config.settings.production

# --- Database (Postgres container, same docker network) ---
DB_NAME=urbanattic
DB_USER=urbanattic
DB_PASSWORD=CHANGE-ME-TO-A-LONG-RANDOM-STRING
DB_HOST=postgres
DB_PORT=5432

# --- Redis (container, same docker network) ---
REDIS_URL=redis://redis:6379/0

# --- CORS / CSRF (frontend on Vercel) ---
CORS_ALLOWED_ORIGINS=https://urbanattic.francocazal.com,https://urbanattic.vercel.app

# --- Frontend URL (used for Stripe redirects, password reset links, etc.) ---
FRONTEND_URL=https://urbanattic.vercel.app

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_or_live_...
STRIPE_PUBLISHABLE_KEY=pk_test_or_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (SendGrid via django-anymail) ---
SENDGRID_API_KEY=SG.your-key
DEFAULT_FROM_EMAIL=Urban Attic <noreply@francocazal.com>

# --- AWS S3 (media storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=portfolio-bucket-franco
AWS_S3_REGION_NAME=us-east-1

# --- SSL behavior (Caddy terminates TLS and forwards X-Forwarded-Proto) ---
SECURE_SSL_REDIRECT=True
